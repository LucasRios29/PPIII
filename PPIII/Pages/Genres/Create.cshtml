@page
@model PPIII.Pages.Genres.CreateModel

<h1>Crear Género</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Genre.Name"></label>
        <input asp-for="Genre.Name" class="form-control" />
        <span asp-validation-for="Genre.Name" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Crear</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>