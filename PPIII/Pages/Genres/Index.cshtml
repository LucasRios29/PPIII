@page
@model PPIII.Pages.Genres.IndexModel

<h1>Géneros</h1>

<p><a asp-page="Create">Crear nuevo género</a></p>

<table class="table">
    <thead>
        <tr><th>Id</th><th>Nombre</th><th></th></tr>
    </thead>
    <tbody>
@foreach(var g in Model.GenreList) {
    <tr>
        <td>@g.Id</td>
        <td>@g.Name</td>
        <td>
            <a asp-page="Edit" asp-route-id="@g.Id">Editar</a> |
            <a asp-page="Delete" asp-route-id="@g.Id">Eliminar</a>
        </td>
    </tr>
}
    </tbody>
</table>