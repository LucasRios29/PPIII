@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-4">
    <h1 class="mb-4">Panel principal</h1>

    <div class="mb-3">
        <a asp-page="/Movies/Create" class="btn btn-lg btn-primary me-2">Crear película</a>
        <a asp-page="/Genres/Create" class="btn btn-lg btn-secondary me-2">Crear género</a>
        <a asp-page="/Ratings/Create" class="btn btn-lg btn-warning">Crear clasificación (Rating)</a>
    </div>

    <hr />

    <div class="mt-3">
        <a asp-page="/Movies/Manage" class="btn btn-outline-primary me-2">Ver películas</a>
        <a asp-page="/Genres/Index" class="btn btn-outline-secondary me-2">Ver géneros</a>
        <a asp-page="/Ratings/Index" class="btn btn-outline-warning me-2">Ver clasificaciones</a>

        <!-- Botón de administrar películas: SOLO en Home -->
        <!-- <a asp-page="/Movies/Manage" class="btn btn-outline-dark">Administrar películas</a> -->
    </div>
</div>
