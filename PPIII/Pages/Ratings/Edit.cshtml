@page "{id:int}"
@model PPIII.Pages.Ratings.EditModel

<h1>Editar Clasificación</h1>

<form method="post">
    <input type="hidden" asp-for="Rating.Id" />
    <div class="form-group">
        <label asp-for="Rating.Name"></label>
        <input asp-for="Rating.Name" class="form-control" />
        <span asp-validation-for="Rating.Name" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>